#!/usr/bin/env bash

set -uo pipefail

readonly POLL_SECONDS=2
readonly DEAD_BAND=3

OFFSET_PERCENT=${1:-0}
STEP_PERCENT=${2:-2}
SAMPLE_COUNT=${3:-5}

sensor_path=""
sensor_source="acpi-als"
sensor_scale=1
last_written=-1
manual_override=0
manual_lux=0
samples=()

[[ "$OFFSET_PERCENT" =~ ^-?[0-9]+$ ]] || OFFSET_PERCENT=0
[[ "$STEP_PERCENT" =~ ^[0-9]+$ ]] || STEP_PERCENT=2
[[ "$SAMPLE_COUNT" =~ ^[0-9]+$ ]] || SAMPLE_COUNT=5
(( OFFSET_PERCENT < -20 )) && OFFSET_PERCENT=-20
(( OFFSET_PERCENT > 20 )) && OFFSET_PERCENT=20
(( STEP_PERCENT < 1 )) && STEP_PERCENT=1
(( STEP_PERCENT > 5 )) && STEP_PERCENT=5
(( SAMPLE_COUNT < 1 )) && SAMPLE_COUNT=1
(( SAMPLE_COUNT > 10 )) && SAMPLE_COUNT=10

find_sensor() {
  local name_file device pass
  # Prefer the MacBook's acpi-als, then any IIO light sensor. Sensors such as
  # the Intel sensor hub's "als" expose only raw counts plus a scale.
  for pass in acpi-als any; do
    for name_file in /sys/bus/iio/devices/iio:device*/name; do
      [[ -r "$name_file" ]] || continue
      [[ $pass == any || "$(<"$name_file")" == "acpi-als" ]] || continue
      device=${name_file%/name}
      sensor_scale=1
      if [[ -r "$device/in_illuminance_input" ]]; then
        sensor_path="$device/in_illuminance_input"
      elif [[ -r "$device/in_illuminance_raw" ]]; then
        sensor_path="$device/in_illuminance_raw"
        [[ -r "$device/in_illuminance_scale" ]] && sensor_scale=$(<"$device/in_illuminance_scale")
      else
        continue
      fi
      sensor_source=$(<"$name_file")
      return 0
    done
  done
  return 1
}

read_lux() {
  local value
  [[ -r "$sensor_path" ]] || return 1
  value=$(<"$sensor_path")
  [[ "$value" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1
  awk -v value="$value" -v scale="$sensor_scale" -v src="$sensor_source" 'BEGIN { printf "%d %s\n", value * scale + 0.5, src }'
}

average_lux() {
  local value=$1 sum=0 sample
  samples+=("$value")
  while (( ${#samples[@]} > SAMPLE_COUNT )); do
    samples=("${samples[@]:1}")
  done
  for sample in "${samples[@]}"; do (( sum += sample )); done
  printf '%d\n' "$(( sum / ${#samples[@]} ))"
}

brightness_percent() {
  local current maximum
  current=$(brightnessctl get) || return 1
  maximum=$(brightnessctl max) || return 1
  (( maximum > 0 )) || return 1
  printf '%d\n' "$(( (current * 100 + maximum / 2) / maximum ))"
}

map_lux_to_percent() {
  local lux=$1 index low_lux high_lux low_pct high_pct target=100
  local -a lux_points=(0 5 20 50 100 200 400 700 1200 2000)
  local -a pct_points=(12 15 22 30 40 52 65 78 90 100)

  for (( index=1; index<${#lux_points[@]}; index++ )); do
    if (( lux <= lux_points[index] )); then
      low_lux=${lux_points[index-1]}
      high_lux=${lux_points[index]}
      low_pct=${pct_points[index-1]}
      high_pct=${pct_points[index]}
      target=$(( low_pct + (lux - low_lux) * (high_pct - low_pct) / (high_lux - low_lux) ))
      break
    fi
  done

  target=$(( target + OFFSET_PERCENT ))
  (( target < 5 )) && target=5
  (( target > 100 )) && target=100
  printf '%d\n' "$target"
}

absolute_difference() {
  local left=$1 right=$2
  if (( left >= right )); then printf '%d\n' "$(( left - right ))"
  else printf '%d\n' "$(( right - left ))"; fi
}

write_state() {
  printf '{"lux":%d,"brightness":%d,"target":%d,"manualOverride":%s,"sensor":"%s"}\n' \
    "$1" "$2" "$3" "$([[ "$manual_override" == 1 ]] && printf true || printf false)" "$sensor_source"
}

while ! find_sensor; do sleep 5; done
last_written=$(brightness_percent) || last_written=-1
logger -t auto-brightness "Started with sensor $sensor_path"

while true; do
  read -r raw_lux sensor_source < <(read_lux) || {
    sensor_path=""
    while ! find_sensor; do sleep 5; done
    sleep "$POLL_SECONDS"
    continue
  }
  lux=$(average_lux "$raw_lux")
  current=$(brightness_percent) || { sleep "$POLL_SECONDS"; continue; }

  if (( last_written >= 0 )); then
    difference=$(absolute_difference "$current" "$last_written")
    if (( difference > 2 && manual_override == 0 )); then
      manual_override=1
      manual_lux=$lux
      logger -t auto-brightness "Manual override at ${current}% and ${lux} lux"
    fi
  fi

  target=$(map_lux_to_percent "$lux")
  if (( manual_override == 1 )); then
    lux_change=$(absolute_difference "$lux" "$manual_lux")
    resume_threshold=$(( manual_lux / 2 ))
    (( resume_threshold < 10 )) && resume_threshold=10
    if (( lux_change < resume_threshold )); then
      last_written=$current
      write_state "$lux" "$current" "$target"
      sleep "$POLL_SECONDS"
      continue
    fi
    manual_override=0
    last_written=$current
    samples=("$raw_lux")
    lux=$raw_lux
    target=$(map_lux_to_percent "$lux")
    logger -t auto-brightness "Resuming after ambient light changed to ${lux} lux"
  fi

  difference=$(absolute_difference "$current" "$target")
  if (( difference > DEAD_BAND )); then
    if (( current < target )); then
      next=$(( current + STEP_PERCENT )); (( next > target )) && next=$target
    else
      next=$(( current - STEP_PERCENT )); (( next < target )) && next=$target
    fi
    if brightnessctl -q set "${next}%"; then last_written=$next; current=$next; fi
  else
    last_written=$current
  fi

  write_state "$lux" "$current" "$target"
  sleep "$POLL_SECONDS"
done
